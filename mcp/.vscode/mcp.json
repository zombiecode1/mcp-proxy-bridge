{
  "$schema": "https://aka.ms/vscode/mcp-schema.json",
  "servers": {
    "mcp-agent-server": {
      "type": "stdio",
      "command": "node",
      "args": ["./dist/server.js"],
      "cwd": "${workspaceFolder}"
    },
    "proxi-bridge": {
      "type": "http",
      "url": "http://localhost:5001/mcp",
      "description": "ZombieCoder proxi bridge — Groq-powered MCP with workspace tools (SSE streaming, session management)"
    }
  },
  "inputs": []
}
